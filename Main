                        cin.get();
                        break;
                    case traspo1:
                        cout << "Info sobre cifrado por transposicion" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case a1z26_1:
                        cout << "Info sobre cifrado A1Z26" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case atbash1:
                        cout << "Info sobre cifrado Atbash" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
