#include <iostream> // Permite usar std::cin y std::coutpara la consola (entrada y salida)
#include <string> // Permite manejar cadenas de texto (std::string)
#include <sstream> // Permite tratar un texto como un flujo (stream) para separar letras o numeros por espacios
#include <cctype> // Contiene funciones utiles para verificar caracteres, como isalpha() (si es letra) o isdigit() (si es numero)
#include <algorithm>
#include <vector>
#include "cyph3r.h"

using namespace std;
using namespace cyph3r;

//ENUMS PARA SWITCHS DE MENU
enum OpcMenu {infoMetod = 1, cifradoDescifrado, salir};
enum Cifrados {cesar = 1,codMorse,traspo,a1z26,atbash,atras};

int main() {

    // VARIABLES PARA MENU Y OPCIONES DE MENU
    string user = "0";
    int usuario = 0;
    char exit = 'n';
    string exitUser = "0";
    int info = 0;
    string infoUser = "0";
    int metod = 0;
    string metodos = "0";
    string cifrado = "0";
    string repetir = "0";

    //VARIABLES CESAR
    string phrase = " ";
    int recorrido = 0;
    bool minusk = 1;
    int letra;

    //VARIABLES CODIGO MORSE
    string morse[26];
    morse[0]=".-"; morse[1]="-..."; morse[2]="-.-."; morse[3]="-.."; morse[4]=".";
    morse[5]="..-."; morse[6]="--."; morse[7]="...."; morse[8]=".."; morse[9]=".---";
    morse[10]="-.-"; morse[11]=".-.."; morse[12]="--"; morse[13]="-."; morse[14]="---";
    morse[15]=".--."; morse[16]="--.-"; morse[17]=".-."; morse[18]="..."; morse[19]="-";
    morse[20]="..-"; morse[21]="...-"; morse[22]=".--"; morse[23]="-..-"; morse[24]="-.--";
    morse[25]="--..";

    //Arreglo de letras
    char abc[26];
    for(int i = 0; i < 26; i++){
        int last = i;
        abc[i] = 'a' + static_cast<char>(last);
    }


    // VARIABLES PARA CIFRADO Y DESCIFRADO DE ATBASH
    string palabra;
    string s = "s";
     // Funciona para elegir cual funcion
    bool minusc = 0;

    // VARIABLES PARA CIFRADO Y DESCIFRADO DE A1Z26
    int opc = 0;
    bool avnzr = true; // Variable booleana para controlar cuando salir del Cifrado A1Z26
    int contC = 0;
    int contD = 0;
    bool conf = 0;
    string entr;

    //VARIABLES PARA CIFRADO Y DESCIFRADO POR TRANSPOSCISIÓN
    string word;
    string frase;
    vector <string>lista;

    do {
        // MENU DE INICIO
        cyph3r::printMenu(user,usuario);
        OpcMenu menu = static_cast<OpcMenu>(usuario); //conversion de variable int al enum.

        //Opciones del menu
        switch(menu){
            case infoMetod:{
                cout << " " << endl;
                cout << "Metodos de cifrado en el programa" << endl;
                cout << "1. Cifrado Cesar" << endl;
                cout << "2. Codigo Morse" << endl;
                cout << "3. Cifrado por Transposicion" << endl;
                cout << "4. Cifrado A1Z26" << endl;
                cout << "5. Cifrado Atbash" << endl;
                cout << "6. Atras" << endl;
                cout << "Seleccione la opcion que desea visualizar: ";
                getline(cin,infoUser);
                while(infoUser != "1" && infoUser != "2" && infoUser != "3" && infoUser != "4" && infoUser != "5" && infoUser != "6"){
                    cout << "Dato invalido. Ingrese nuevamente: ";
                    getline(cin, infoUser);
                }
                info = stoi(infoUser);
                Cifrados infoMetodos = static_cast<Cifrados>(info);
                cout << " " << endl;
                switch(infoMetodos){
                    case cesar:
                        cout << "Info sobre cifrado cesar" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case codMorse:
                        cout << "Info sobre codigo morse" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case traspo:
                        cout << "Info sobre cifrado por transposicion" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case a1z26:
                        cout << "Info sobre cifrado A1Z26" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case atbash:
                        cout << "Info sobre cifrado Atbash" << endl;
                        cout << endl << "Presione enter para regresar al menu: ";
                        cin.get();
                        break;
                    case atras:
                        break;
                }}
                break;

            case cifradoDescifrado:{
                cout << "Deseas cifrar (1) o descifrar (0)? ";
                getline(cin, cifrado);

                while (cifrado != "1" && cifrado != "0") {
                    cout << "Dato invalido. Ingresa 1 para cifrar o 0 para descifrar: ";
                    getline(cin, cifrado);
                }
                cyph3r::printMetod(metod);
                Cifrados cifrados = static_cast<Cifrados>(metod);

                switch(cifrados){
                    case cesar:
                        if (cifrado == "1") {
                            cyph3r::cifrcesar(phrase, recorrido, minusk, letra);
                        }
                        else {

                        cout << "Trabajando en ello :)" << endl;
                        }
                        break;
                    case codMorse:
                        if(cifrado == "1"){
                            cyph3r::cifrMorse(morse,abc);
                        } else {
                            //decifrMorse(morse,abc);
                        }
                        break;
                    case traspo:{
                        string repetir;
                        do{
                            cout << " " << endl;
                            cout << "---Cifrado y descifrado por transposicion---" << endl;
                            cout <<"Escribe una palabra o frase:";
                            getline(cin,frase);//lee todo
                            cyph3r::metTranspo(frase,cifrado);
                            cout << "\n¿Quiere volver a cifrar o descifrar? (s/n): ";
                            getline(cin,repetir);


                        }while(repetir == "s" || repetir == "S");

                        break;}
                    case a1z26:
                        avnzr = true; // Reiniciamos para que funcione si vuelven a entrar
                        // El bucle se repite mientras 'avnzr' sea 'true'
                        while (avnzr == true) {
                           if (cifrado == "1"){
                                cout << "Introduce el texto a cifrar: " << endl;
                                getline(cin, entr); // Lee toda la linea incluyendo espacios
                                string cypher = cyph3r::cifrarA1Z26(entr); // Llamamos a nuestra funcion de cifrado
                                cout << endl << "Resultado cifrado:" << endl << cypher << endl;
                                contC++;
                        }
                            else {
                                    cout << "Introduce el codigo cifrado (numeros separados por espacios):" << endl;
                                    getline(cin, entr); // Lee toda la linea incluyendo espacios
                                    string decypher = cyph3r::descifrarA1Z26(entr); // Llamamos a nuestra funcion de descifrado
                                    cout << endl << "Resultado descifrado:" << endl << decypher << endl;
                                    contD++;
                            }
                            cout << " " << endl;
                            cout << "Si desea volvera cifrar en este método presione s, sino cualquier otra tecla: " ;
                            getline(cin, repetir);
                            if (repetir != "s") {
                                avnzr = false;
                            }
                                }
                            break;

                    case atbash: { // Atbash actualizado correctamente
                        cyph3r::cifratbash(palabra,cifrado,minusc,contC,contD,s);
                        break;}
                    case atras:
                        break;
                }

                break;}

            case salir: // Salir
                cout << "Seguro que desea salir (si = s / no = n): ";
                getline(cin,exitUser);
                while(exitUser != "s" && exitUser != "n"){
                    cout << "Dato invalido. Ingrese nuevamente: ";
                    getline(cin,exitUser);
                }
                if(exitUser == "s"){
                    cout << "Cantidad de mensajes cifrados: " << contC << endl;
                    cout << "Descifrados: " << contD << endl;
                    cout << "Total: " << contC + contD << endl;
                    cout << "Hasta nunca :D";
                    return 0;
                } else if(exitUser == "n") {
                    user = "0";
                    cout << endl;
                }
            }
    } while(user != "3");

    return 0;
}
